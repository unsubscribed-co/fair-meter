    "MeteringErrorsAlarm61973B61": {
      "Properties": {
        "AlarmActions": [
          "arn:aws:sns:us-east-2:111111111111:a",
        ],
        "AlarmDescription": "stacksplit prod: a metering error (METER_UNAVAILABLE, PRICE_MISSING, SERVICE_PAUSED, CALL_EXCEEDS_CAP, CALL_ID_REUSED, USAGE_MISSING, RECORD_CONFLICT, USAGE_RECORD_FAILED, RESERVATION_EXCEEDED, USAGE_RECORD_PARKED, ACTION_UNKNOWN, ACTION_UNPRICED, ROLLUP_TRUNCATED, ROLLUP_FAILED, ROLLUP_LATE) or a failed rollup run: check the app function's logs",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Expression": "FILL(errors, 0) + FILL(rollupFailures, 0)",
            "Id": "expr_1",
            "ReturnData": true,
          },
          {
            "Id": "errors",
            "MetricStat": {
              "Metric": {
                "MetricName": "stacksplit-prod-MeteringErrors",
                "Namespace": "FairMeter",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "rollupFailures",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "FunctionName",
                    "Value": {
                      "Ref": "MeteringRollup8C8E010F",
                    },
                  },
                ],
                "MetricName": "Errors",
                "Namespace": "AWS/Lambda",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
